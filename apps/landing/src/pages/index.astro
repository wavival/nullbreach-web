---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import Icon from "../components/Icon.astro";
import LangToggle from "../components/LangToggle.tsx";

// Where the React SPA lives. Login/CTAs link into it. Override at build time
// with PUBLIC_SPA_BASE (e.g. an absolute URL for a separate deployment).
const SPA_BASE = import.meta.env.PUBLIC_SPA_BASE ?? "/nullbreach";
const LOGIN_URL = `${SPA_BASE}/login`;

const REPO_URL = "https://github.com/wavival/nullbreach-web";
const AUTHOR_URL = "https://wavival.dev";
const AUTHOR_NAME = "Valentina Ramírez";
const AUTHOR_HOST = "wavival.dev";
const YEAR = new Date().getFullYear();

const features = [
  {
    icon: "message-square",
    es: {
      title: "Chat de ciberseguridad",
      body: "Conversa sobre vulnerabilidades, vectores de ataque y mitigaciones. Respuestas con contexto y referencias accionables.",
    },
    en: {
      title: "Cybersecurity chat",
      body: "Talk through vulnerabilities, attack vectors, and mitigations. Context-rich answers with actionable references.",
    },
  },
  {
    icon: "scan-line",
    es: {
      title: "Analizador de código",
      body: "Pega tu código fuente y recibe un análisis estático con hallazgos clasificados por severidad.",
    },
    en: {
      title: "Code analyzer",
      body: "Paste your source code and get static analysis with findings ranked by severity.",
    },
  },
  {
    icon: "bug",
    es: {
      title: "OWASP y modelado de amenazas",
      body: "Mapea riesgos al Top 10 de OWASP y razona sobre superficies de ataque y trust boundaries.",
    },
    en: {
      title: "OWASP & threat modeling",
      body: "Map risks to the OWASP Top 10 and reason about attack surfaces and trust boundaries.",
    },
  },
] as const;

const steps = [
  {
    icon: "lock",
    es: {
      title: "Crea tu cuenta",
      body: "Regístrate e inicia sesión con autenticación segura basada en JWT.",
    },
    en: {
      title: "Create your account",
      body: "Register and sign in with secure JWT-based authentication.",
    },
  },
  {
    icon: "terminal",
    es: {
      title: "Pregunta o analiza",
      body: "Abre un chat o envía código al analizador para obtener un diagnóstico.",
    },
    en: {
      title: "Ask or analyze",
      body: "Open a chat or send code to the analyzer for a diagnosis.",
    },
  },
  {
    icon: "zap",
    es: {
      title: "Actúa sobre los hallazgos",
      body: "Prioriza por severidad y aplica las mitigaciones sugeridas.",
    },
    en: {
      title: "Act on findings",
      body: "Prioritize by severity and apply the suggested mitigations.",
    },
  },
] as const;

const stats = [
  { value: "OWASP", es: "Top 10 cubierto", en: "Top 10 covered" },
  { value: "IA", es: "Chat especializado", en: "Specialized chat" },
  { value: "SAST", es: "Análisis de código", en: "Code analysis" },
] as const;

const primaryBtn =
  "inline-flex items-center gap-sm rounded bg-primary text-primary-foreground font-medium transition-all duration-hover ease-hover hover:bg-primary-hover hover:shadow-[0_10px_30px_-8px_rgba(34,197,94,0.6)] active:bg-primary-active active:scale-[0.99] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/50 focus-visible:ring-offset-2 focus-visible:ring-offset-surface";
---

<Base>
  <!-- ============================== Nav ============================== -->
  <header
    class="sticky top-0 z-50 w-full border-b border-border bg-surface/80 backdrop-blur-md"
  >
    <div
      class="mx-auto flex h-14 max-w-[1200px] items-center justify-between gap-md px-md md:h-navbar md:px-lg lg:px-xl"
    >
      <a href="#top" class="flex items-center gap-sm font-headline text-h4">
        <Icon
          name="shield-half"
          class="size-6 text-primary drop-shadow-[0_0_10px_rgba(34,197,94,0.45)]"
        />
        <span class="text-primary">NullBreach</span>
      </a>

      <nav
        class="hidden items-center gap-xl text-body text-foreground-muted md:flex"
      >
        <a
          href="#features"
          class="transition-colors duration-hover hover:text-foreground"
        >
          <T es="Características" en="Features" />
        </a>
        <a
          href="#how"
          class="transition-colors duration-hover hover:text-foreground"
        >
          <T es="Cómo funciona" en="How it works" />
        </a>
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors duration-hover hover:text-foreground"
        >
          <T es="Proyecto" en="Project" />
        </a>
      </nav>

      <div class="flex items-center gap-sm">
        <LangToggle client:load />
        <a href={LOGIN_URL} class={`${primaryBtn} h-9 px-lg text-body`}>
          <T es="Iniciar sesión" en="Sign in" />
        </a>
      </div>
    </div>
  </header>

  <main class="flex-1">
    <!-- ============================ Hero ============================ -->
    <section id="top" class="relative overflow-hidden border-b border-border">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-32 -top-40 size-[520px] rounded-full bg-primary/10 blur-3xl"
      >
      </div>
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-48 -left-40 size-[560px] rounded-full bg-secondary/10 blur-3xl"
      >
      </div>

      <div
        class="relative mx-auto max-w-[1200px] px-md py-3xl md:px-lg lg:px-xl lg:py-4xl"
      >
        <div class="grid items-center gap-2xl lg:grid-cols-2 lg:gap-4xl">
          <div class="flex animate-fade-in-up flex-col gap-lg">
            <span
              class="inline-flex items-center gap-sm self-start rounded-full border border-primary/30 bg-primary/10 px-md py-xs text-body-sm text-primary"
            >
              <Icon name="sparkles" class="size-3.5" />
              <T
                es="Asistente de ciberseguridad con IA"
                en="AI-powered cybersecurity assistant"
              />
            </span>

            <h1
              class="font-headline text-[40px] leading-[1.1] tracking-[-1px] text-foreground sm:text-[48px] lg:text-[56px]"
            >
              <T
                es="Encuentra y entiende vulnerabilidades antes que los atacantes."
                en="Find and understand vulnerabilities before attackers do."
              />
            </h1>

            <p class="max-w-[560px] text-body-lg text-foreground-muted">
              <T
                es="NullBreach combina chat con IA y análisis estático de código para ayudarte a razonar sobre OWASP, modelado de amenazas y endurecimiento — en lenguaje claro."
                en="NullBreach pairs an AI chat with static code analysis to help you reason about OWASP, threat modeling, and hardening — in plain language."
              />
            </p>

            <div class="mt-xs flex flex-wrap items-center gap-md">
              <a href={LOGIN_URL} class={`${primaryBtn} h-12 px-xl text-body-lg`}>
                <T es="Iniciar sesión" en="Sign in" />
                <Icon name="arrow-right" class="size-4" />
              </a>
              <a
                href="#features"
                class="inline-flex h-12 items-center gap-sm rounded border border-border px-xl text-body-lg font-medium text-foreground transition-colors duration-hover ease-hover hover:border-neutral hover:bg-surface-alt focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary/40"
              >
                <T es="Ver características" en="See features" />
              </a>
            </div>

            <dl
              class="mt-xl grid max-w-[460px] grid-cols-3 gap-md border-t border-border/70 pt-xl"
            >
              {
                stats.map((s) => (
                  <div class="flex flex-col gap-xs">
                    <dt class="font-headline text-h3 text-primary">{s.value}</dt>
                    <dd class="text-body-sm text-foreground-muted">
                      <T es={s.es} en={s.en} />
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <div class="relative animate-fade-in-up [animation-delay:120ms]">
            <div
              aria-hidden="true"
              class="absolute -inset-px rounded-lg bg-gradient-to-br from-primary/30 via-transparent to-secondary/20 blur-sm"
            >
            </div>
            <div
              class="relative overflow-hidden rounded-lg border border-border bg-surface-alt/60 shadow-large"
            >
              <div
                class="flex h-9 items-center gap-xs border-b border-border bg-surface/60 px-md"
              >
                <span class="size-2.5 rounded-full bg-tertiary/80"></span>
                <span class="size-2.5 rounded-full bg-warning/80"></span>
                <span class="size-2.5 rounded-full bg-primary/80"></span>
                <span class="ml-sm font-mono text-body-sm text-foreground-muted">
                  nullbreach — scan
                </span>
              </div>
              <img
                src="/banner.png"
                alt="NullBreach"
                class="block h-auto w-full"
                width="1672"
                height="941"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================== Features ========================== -->
    <section
      id="features"
      class="mx-auto max-w-[1200px] scroll-mt-navbar px-md py-3xl md:px-lg lg:px-xl lg:py-4xl"
    >
      <div class="flex max-w-[680px] flex-col gap-sm">
        <span
          class="inline-flex items-center gap-sm self-start text-label uppercase text-primary"
        >
          <Icon name="code" class="size-4" />
          <T es="Qué incluye" en="What's inside" />
        </span>
        <h2 class="font-headline text-h2 text-foreground">
          <T
            es="Seguridad ofensiva y defensiva, en un solo lugar"
            en="Offensive and defensive security, in one place"
          />
        </h2>
        <p class="text-body-lg text-foreground-muted">
          <T
            es="Tres herramientas pensadas para desarrolladores y equipos de seguridad."
            en="Three tools built for developers and security teams."
          />
        </p>
      </div>

      <div class="mt-2xl grid gap-lg sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <article class="group flex flex-col gap-md rounded-lg border border-border bg-surface-alt/50 p-xl backdrop-blur-sm transition-all duration-hover ease-hover hover:-translate-y-[2px] hover:border-primary/50 hover:shadow-[0_12px_30px_-12px_rgba(34,197,94,0.35)]">
              <span class="inline-flex size-11 items-center justify-center rounded border border-primary/30 bg-primary/10 text-primary">
                <Icon name={f.icon} class="size-5" />
              </span>
              <h3 class="font-headline text-h4 text-foreground">
                <T es={f.es.title} en={f.en.title} />
              </h3>
              <p class="text-body text-foreground-muted">
                <T es={f.es.body} en={f.en.body} />
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ========================= How it works ====================== -->
    <section
      id="how"
      class="scroll-mt-navbar border-y border-border bg-surface-alt/30"
    >
      <div
        class="mx-auto max-w-[1200px] px-md py-3xl md:px-lg lg:px-xl lg:py-4xl"
      >
        <div class="flex max-w-[680px] flex-col gap-sm">
          <span
            class="inline-flex items-center gap-sm self-start text-label uppercase text-primary"
          >
            <Icon name="code" class="size-4" />
            <T es="Cómo funciona" en="How it works" />
          </span>
          <h2 class="font-headline text-h2 text-foreground">
            <T
              es="De la duda al hallazgo en tres pasos"
              en="From question to finding in three steps"
            />
          </h2>
        </div>

        <ol class="mt-2xl grid gap-lg md:grid-cols-3">
          {
            steps.map((s, i) => (
              <li class="relative flex flex-col gap-md rounded-lg border border-border bg-surface/60 p-xl">
                <div class="flex items-center gap-md">
                  <span class="inline-flex size-9 items-center justify-center rounded-full bg-primary font-headline text-body-lg text-primary-foreground">
                    {i + 1}
                  </span>
                  <Icon name={s.icon} class="size-5 text-primary" />
                </div>
                <h3 class="font-headline text-h4 text-foreground">
                  <T es={s.es.title} en={s.en.title} />
                </h3>
                <p class="text-body text-foreground-muted">
                  <T es={s.es.body} en={s.en.body} />
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ============================ CTA ============================ -->
    <section
      class="mx-auto max-w-[1200px] px-md py-3xl md:px-lg lg:px-xl lg:py-4xl"
    >
      <div
        class="relative flex flex-col items-center gap-md overflow-hidden rounded-lg border border-primary/30 bg-gradient-to-br from-surface-alt to-surface px-xl py-2xl text-center lg:px-2xl lg:py-3xl"
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -top-24 left-1/2 size-[360px] -translate-x-1/2 rounded-full bg-primary/15 blur-3xl"
        >
        </div>
        <h2 class="relative max-w-[640px] font-headline text-h2 text-foreground">
          <T
            es="¿Listo para fortalecer tu código?"
            en="Ready to harden your code?"
          />
        </h2>
        <p class="relative max-w-[520px] text-body-lg text-foreground-muted">
          <T
            es="Inicia sesión y empieza tu primer análisis en minutos."
            en="Sign in and run your first analysis in minutes."
          />
        </p>
        <a
          href={LOGIN_URL}
          class={`${primaryBtn} relative mt-sm h-12 px-xl text-body-lg`}
        >
          <T es="Iniciar sesión" en="Sign in" />
          <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
    </section>
  </main>

  <!-- =========================== Footer =========================== -->
  <footer class="border-t border-border bg-surface">
    <div class="mx-auto max-w-[1200px] px-md py-2xl md:px-lg lg:px-xl">
      <div class="grid gap-2xl md:grid-cols-[1.5fr_1fr_1fr]">
        <div class="flex max-w-[320px] flex-col gap-sm">
          <span class="flex items-center gap-sm font-headline text-h4">
            <Icon name="shield-half" class="size-6 text-primary" />
            <span class="text-primary">NullBreach</span>
          </span>
          <p class="text-body-sm text-foreground-muted">
            <T
              es="Asistente de ciberseguridad con IA."
              en="AI-powered cybersecurity assistant."
            />
          </p>
        </div>

        <nav class="flex flex-col gap-sm">
          <h4 class="text-label uppercase text-foreground-muted">
            <T es="Producto" en="Product" />
          </h4>
          <a
            href="#features"
            class="text-body text-foreground-muted transition-colors duration-hover hover:text-primary"
          >
            <T es="Características" en="Features" />
          </a>
          <a
            href="#how"
            class="text-body text-foreground-muted transition-colors duration-hover hover:text-primary"
          >
            <T es="Cómo funciona" en="How it works" />
          </a>
          <a
            href={LOGIN_URL}
            class="text-body text-foreground-muted transition-colors duration-hover hover:text-primary"
          >
            <T es="Iniciar sesión" en="Sign in" />
          </a>
        </nav>

        <nav class="flex flex-col gap-sm">
          <h4 class="text-label uppercase text-foreground-muted">
            <T es="Recursos" en="Resources" />
          </h4>
          <a
            href={REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-sm text-body text-foreground-muted transition-colors duration-hover hover:text-primary"
          >
            <Icon name="github" class="size-4" />
            <T es="Repositorio" en="Repository" />
          </a>
          <a
            href={AUTHOR_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-sm text-body text-foreground-muted transition-colors duration-hover hover:text-primary"
          >
            <Icon name="globe" class="size-4" />
            <T es="Autora" en="Author" />
          </a>
        </nav>
      </div>

      <div
        class="mt-2xl flex flex-col items-center justify-between gap-sm border-t border-border pt-lg text-body-sm text-foreground-muted sm:flex-row"
      >
        <span class="inline-flex items-center gap-xs">
          <Icon name="check" class="size-3.5 text-primary" />
          © {YEAR} {AUTHOR_NAME}.
          <T es="Todos los derechos reservados." en="All rights reserved." />
        </span>
        <a
          href={AUTHOR_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-sm rounded-full transition-colors duration-hover"
        >
          <img
            src="/profile.webp"
            width="32"
            height="32"
            loading="lazy"
            decoding="async"
            alt={AUTHOR_NAME}
            class="size-8 rounded-full border border-border object-cover"
          />
          <span class="text-body-sm text-foreground-muted">
            <T es="Creado por" en="Built by" />{" "}
            <span
              class="text-secondary underline-offset-2 group-hover:text-secondary-hover group-hover:underline"
            >
              {AUTHOR_NAME}
            </span>
          </span>
        </a>
      </div>
    </div>
  </footer>
</Base>
