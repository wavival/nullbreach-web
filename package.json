{
  "name": "nullbreach",
  "private": true,
  "version": "0.1.0",
  "description": "NullBreach monorepo — AI-powered cybersecurity assistant. Frontend (React + Vite SPA), landing (Astro), and backend (Django REST).",
  "author": {
    "name": "Valentina Ramírez",
    "url": "https://wavival.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavival/nullbreach-web.git"
  },
  "workspaces": [
    "apps/frontend",
    "apps/landing"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/frontend",
    "dev:landing": "npm run dev --workspace apps/landing",
    "build": "npm run build --workspace apps/frontend",
    "build:landing": "npm run build --workspace apps/landing",
    "build:all": "npm run build --workspace apps/frontend && npm run build --workspace apps/landing",
    "lint": "npm run lint --workspace apps/frontend",
    "typecheck": "npm run typecheck --workspace apps/frontend",
    "test": "npm test --workspace apps/frontend"
  }
}
